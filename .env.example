# Environment Configuration Example
# Copy to .env and customize for your local setup

PROJECT_NAME="Commerce Intelligence API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# SQLite default (zero-configuration local run)
DATABASE_URL=sqlite+aiosqlite:///data/ecommerce.db
SYNC_DATABASE_URL=sqlite:///data/ecommerce.db

# PostgreSQL (production / Docker Compose) — password comes from .env, never hardcode it
# DATABASE_URL=postgresql+asyncpg://admin:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_db
# SYNC_DATABASE_URL=postgresql://admin:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_db

# Required by docker-compose.yml (Compose fails fast if unset)
POSTGRES_PASSWORD=change-this-postgres-password
SECRET_KEY=change-this-to-a-secure-random-key-in-production
