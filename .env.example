# Environment Configuration Example
# Copy to .env and customize for your local setup

PROJECT_NAME="Commerce Intelligence API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# SQLite default (zero-configuration local run)
DATABASE_URL=sqlite+aiosqlite:///data/ecommerce.db
SYNC_DATABASE_URL=sqlite:///data/ecommerce.db

# PostgreSQL (production / Docker Compose)
# DATABASE_URL=postgresql+asyncpg://admin:password123@localhost:5432/ecommerce_db
# SYNC_DATABASE_URL=postgresql://admin:password123@localhost:5432/ecommerce_db

SECRET_KEY=change-this-to-a-secure-random-key-in-production
