{
  "version": "1.0",
  "project": "E-Commerce Sales & Customer Analytics",
  "system_under_test": "scripts/nl_to_sql.py \u2014 answer_question()",
  "description": "37-question NL-to-SQL benchmark across 4 classes. Ground truth is computed INDEPENDENTLY by the harness from data/processed/master_orders.csv (never from the system under test). Questions marked variant=canonical are in-scope for the deterministic pattern-matching fallback; variant=paraphrase are natural re-wordings that the fallback is not expected to cover (they exist to measure the LLM path and to document the paraphrase failure class honestly).",
  "classes": {
    "simple_aggregation": "Single-metric or single-dimension questions",
    "segment_breakdown": "Grouped/segmented questions (category, region, product, segment, subcategory)",
    "time_intelligence": "Time filters, period grouping, quarter/year/MoM logic",
    "refusal": "Unanswerable or out-of-scope questions \u2014 the system must refuse, never fabricate a number"
  },
