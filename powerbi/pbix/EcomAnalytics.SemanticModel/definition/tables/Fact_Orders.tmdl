table Fact_Orders
	lineageTag: 00ff79dd-6f18-5523-82b2-b274a659f90b

	measure 'Total Revenue' =
			CALCULATE(
			    SUM(Fact_Orders[order_item_total]),
			    Fact_Orders[order_status] IN {"Delivered", "Processing"}
			)
		formatString: #,0.00
		lineageTag: 55fabb09-49ba-5510-a6f2-2902ae8e161b

	measure 'Delivered Revenue' =
			CALCULATE(
			    SUM(Fact_Orders[order_item_total]),
			    Fact_Orders[order_status] = "Delivered"
			)
		formatString: #,0.00
		lineageTag: e8a9b14d-7c75-5646-8883-9004249cef8e

	measure 'Total COGS' =
			CALCULATE(
			    SUMX(
			        Fact_Orders,
			        Fact_Orders[quantity] * RELATED(Dim_Products[unit_cost])
			    ),
			    Fact_Orders[order_status] IN {"Delivered", "Processing"}
			)
		formatString: #,0.00
		lineageTag: 7f1750ca-52ea-573d-8e8d-92cbc39a0837

	measure 'Gross Profit' = [Total Revenue] - [Total COGS]
		formatString: #,0.00
		lineageTag: ca03d07c-bc7f-5e67-810c-2aa1c037b205

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Total Revenue], 0)
		formatString: 0.00%
		lineageTag: 9a994076-7250-5135-8260-0ed60ddeb23d

	measure 'Delivered Orders' =
			CALCULATE(
			    DISTINCTCOUNT(Fact_Orders[order_id]),
			    Fact_Orders[order_status] = "Delivered"
			)
		formatString: #,0
		lineageTag: bf64c015-19c9-5e79-bb14-11c5f6a76865

	measure 'Return Rate %' =
			VAR TotalCompleted =
			    CALCULATE(
			        DISTINCTCOUNT(Fact_Orders[order_id]),
			        Fact_Orders[order_status] IN {"Delivered", "Returned"}
			    )
			VAR ReturnedCount =
			    CALCULATE(
			        DISTINCTCOUNT(Fact_Orders[order_id]),
			        Fact_Orders[order_status] = "Returned"
			    )
			RETURN
			    DIVIDE(COALESCE(ReturnedCount, 0), TotalCompleted, 0)
		formatString: 0.00%
		lineageTag: af48cc9d-c4cc-5940-be45-849055b95816

	measure 'Average Order Value' =
			DIVIDE(
			    [Total Revenue],
			    CALCULATE(
			        DISTINCTCOUNT(Fact_Orders[order_id]),
			        Fact_Orders[order_status] IN {"Delivered", "Processing"}
			    ),
			    0
			)
		formatString: #,0.00
		lineageTag: 5a29d7de-31ad-59f8-9457-1f057ae9c590

	measure 'Active Customers' =
			CALCULATE(
			    DISTINCTCOUNT(Fact_Orders[customer_id]),
			    Fact_Orders[order_status] IN {"Delivered", "Processing"}
			)
		formatString: #,0
		lineageTag: ca2b6a4f-388a-5fdb-8297-073ef8123a66

	measure 'MoM Revenue Change %' =
			VAR CurrentMonthRev = [Total Revenue]
			VAR PrevMonthRev =
			    CALCULATE(
			        [Total Revenue],
			        DATEADD(Dim_Calendar[Date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentMonthRev - PrevMonthRev, PrevMonthRev, 0)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 005ed2d9-5c1a-5577-871e-4d0dc287c052

