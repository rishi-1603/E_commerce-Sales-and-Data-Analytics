	partition Fact_Orders = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:/Users/user/portfolio-roadmaps/repos/ecom/powerbi/pbix/data/Fact_Orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(PromotedHeaders, {{"order_date", type datetime}, {"quantity", Int64.Type}, {"unit_price", type number}, {"discount_pct", type number}, {"order_item_total", type number}, {"cost_total", type number}, {"profit", type number}, {"shipping_cost", type number}}, "en-US")
				in
					Typed

